# Copie este arquivo para local.properties e preencha os valores.
# NUNCA commite local.properties — ele está no .gitignore.

# Chave da YouTube Data API v3
# Obtenha em: https://console.developers.google.com/
# 1. Crie um projeto > Ative "YouTube Data API v3" > Crie credencial "API Key"
# 2. Restrinja a chave ao package "com.rcdownload" para maior segurança
YOUTUBE_API_KEY=SUA_CHAVE_AQUI

# URL base do serviço local de download (Flask + yt-dlp)
# 10.0.2.2 = localhost do host quando usando emulador Android
# Para dispositivo físico na mesma rede: use o IP local da máquina (ex: 192.168.1.10)
LOCAL_SERVICE_URL=http://10.0.2.2:8080/

# Caminho do SDK Android (gerado automaticamente pelo Android Studio)
sdk.dir=/home/SEU_USUARIO/Android/Sdk
